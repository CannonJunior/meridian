# Copy to geoserver/.env (untracked — see ../.gitignore) and fill in real
# values before running this stack anywhere beyond a laptop. The fallback
# defaults baked into docker-compose.yml (POSTGRES_PASSWORD=meridian,
# GEOSERVER_ADMIN_PASSWORD=meridian, ...) are dev-only fixtures, not
# something to rely on past localhost.

POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGIS_PORT=5555

GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me
GEOSERVER_PORT=8600
# Defaults (512M/1G) are sized for this dev instance's small vector layers —
# see docker-compose.yml's comment. Raise for a heavier real deployment.
GEOSERVER_INITIAL_MEMORY=512M
GEOSERVER_MAXIMUM_MEMORY=1G
