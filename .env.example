# Copy to .env (untracked — see .gitignore) before running `npm run app:up`.
# This drives docker-compose.yml (server + web) — it's the one compose
# project in this repo meant to be run somewhere beyond a laptop, so unlike
# geoserver/.env.example and kafka/.env.example it has no insecure fallback
# baked in: POSTGRES_PASSWORD and GOOGLE_MAPS_API_KEY must be set explicitly
# (docker-compose.yml will refuse to start otherwise).
#
# POSTGRES_DB/USER/PASSWORD/POSTGIS_PORT and GEOSERVER_PORT must match
# whatever geoserver/.env actually has that stack running with — this app
# tier is a client of it, not a second source of truth for those values.

POSTGRES_DB=meridian
POSTGRES_USER=meridian
POSTGRES_PASSWORD=change-me
POSTGIS_PORT=5555
GEOSERVER_PORT=8600

# Set true only once kafka/README.md's Kafka stack (npm run kafka:up) is
# actually up — see server/src/index.ts's KAFKA_HISTORY_ENABLED /
# KAFKA_LIVE_DOMAINS_ENABLED gating.
KAFKA_EXTERNAL_PORT=9094
KAFKA_HISTORY_ENABLED=false
KAFKA_LIVE_DOMAINS_ENABLED=false

# Server-side only (server/src/googleStaticMap.ts) — never sent to the
# browser. Leave blank to just not have the drawing tool's satellite
# reference-image capture work; nothing else depends on it.
GOOGLE_MAPS_API_KEY=

SERVER_PORT=8799
WEB_PORT=8080
