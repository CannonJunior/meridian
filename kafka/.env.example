# Copy to kafka/.env (untracked — see ../.gitignore) to override any of
# these. Nothing here is a secret (single-node dev broker, public GDELT/
# CelesTrak APIs need no credentials) — this file exists for tuning, not
# for keeping something out of git.

KAFKA_EXTERNAL_PORT=9094

HISTORY_SIM_SEED=42
HISTORY_SIM_ENTITY_COUNT=6
HISTORY_SIM_BACKFILL_HOURS=6
HISTORY_SIM_TICK_SECONDS=300
HISTORY_SIM_BACKFILL_COMPRESSION=300

GDELT_QUERY=(military OR troops OR airstrike OR insurgent OR offensive OR ceasefire)
GDELT_TIMESPAN=1440
GDELT_MAX_POINTS=250
GDELT_POLL_SECONDS=900

CELESTRAK_GROUP=stations
CELESTRAK_CATALOG_REFRESH_SECONDS=21600
CELESTRAK_PROPAGATE_SECONDS=30
